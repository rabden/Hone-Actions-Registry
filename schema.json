{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hone Marketplace Action",
  "type": "object",
  "required": ["id", "name", "description", "icon", "color", "promptTemplate", "category", "version", "author", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^mkt_[a-z0-9_]+$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "icon": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "promptTemplate": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4000
    },
    "systemPrompt": {
      "type": "string",
      "maxLength": 12000
    },
    "category": {
      "type": "string",
      "const": "marketplace"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "maxLength": 24
      }
    }
  }
}
